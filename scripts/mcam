#!/usr/bin/env python3
"""mcam: Mantra Camera driven from the Mac through adb (v139, Marko 22.10.2026).

    mcam state                     what is set, what the sensor took, how bright the picture is
    mcam settings                  v144: every setting of the settings screen, name=value
    mcam set NAME VALUE            v144: one of them (mcam set fps 25, set armNdi on, set ndiTransport USB_CABLE);
                                   what the camera is built with makes it again, the stream kept
    mcam restart                   v144: the camera made again
    mcam update                    v144: the newest release from GitHub, downloaded by Android to install
    mcam lens 2                    a lens by its number in the drawer (L1, L2 …); the stream is kept
    mcam torch on|off|toggle       the light
    mcam exposure auto             both ISO and shutter back to automatic
    mcam iso 400|auto              ISO by hand (shutter stays as it is: auto = ISO priority)
    mcam shutter 1/50|0.02|auto    shutter by hand
    mcam ev +1|-0.7                exposure compensation in stops (with automatic exposure)
    mcam wb 4500|auto              white balance in kelvin; auto measures once and keeps the number
    mcam focus 0..1|auto           0 is infinity, 1 the closest
    mcam circle iso|wb|tap|+|-     the circle (v143): its mode, a tap on it, the shutter a stop faster or slower
    mcam key NAME                  any rail key by its name (REC, MARK0, a label)
    mcam fix                       look at the picture and correct it: light, exposure, white balance
    mcam snap out.png              the phone's screen as a picture
    mcam open                      bring Mantra Camera to the front

The phone: $MCAM_SERIAL, or the Pixel 7 on the cable or over wireless debugging (found by mDNS and connected).
The camera answers only the shell (its receiver asks for DUMP), so this works through adb and from nothing else,
and only while Settings → MORE → ADB CONTROL is on (on by default, v144).
"""
import os, re, shlex, subprocess, sys, time

ADB = os.path.expanduser("~/Library/Android/sdk/platform-tools/adb")
PKG = "com.mantraproductions.manualcamera"
ACTION = PKG + ".ADB"
PIXEL = "41241FDH2S10SJ"


def run(*args, timeout=20):
    return subprocess.run([ADB, *args], capture_output=True, text=True, timeout=timeout).stdout


def device():
    if os.environ.get("MCAM_SERIAL"):
        return os.environ["MCAM_SERIAL"]
    lines = [l.split() for l in run("devices", "-l").splitlines()[1:] if " device " in l + " "]
    for l in lines:
        if l[0] == PIXEL or "model:Pixel_7" in l:
            return l[0]
    addr = wireless()
    if addr:
        return addr
    sys.exit("mcam: no Pixel 7 on adb (cable, or Wireless debugging on the phone)")


def bonjour(*args, seconds=3.0):
    """macOS's own dns-sd, which never exits by itself: read for a few seconds, then stop it."""
    p = subprocess.Popen(["/usr/bin/dns-sd", *args], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    try:
        out, _ = p.communicate(timeout=seconds)
    except subprocess.TimeoutExpired:
        p.kill()
        out, _ = p.communicate()
    return out


def wireless():
    """THE PIXEL OVER WIRELESS DEBUGGING (29.10.2026, Marko: "fix detection of ADB ... wirelessly"). Two faults found:
    adb's own discovery (openscreen) listens only on the networks that existed when the adb server started, so after
    a restart with the cable, the tunnel or the Wi-Fi changing later it hears nothing although the phone announces
    itself; and a dozing Wi-Fi often drops the first connect ("No route to host"). So: adb's discovery first, then
    macOS's Bonjour (dns-sd), which always hears it; then connect by address, a few tries."""
    addr = None
    for l in run("mdns", "services").splitlines():
        if PIXEL in l and "_adb-tls-connect" in l:
            addr = l.split()[-1]
    if not addr:
        names = re.findall(r"(adb-%s-\S+)" % PIXEL, bonjour("-B", "_adb-tls-connect._tcp", "local."))
        if names:
            m = re.search(r"can be reached at (\S+?)\.?:(\d+)", bonjour("-L", names[-1], "_adb-tls-connect._tcp", "local."))
            if m:
                import socket
                try:
                    addr = f"{socket.gethostbyname(m.group(1))}:{m.group(2)}"
                except OSError:
                    addr = None
    if not addr:
        return None
    for _ in range(4):
        out = run("connect", addr, timeout=10)
        if "connected to" in out and any(l.split()[:2] == [addr, "device"] for l in run("devices").splitlines()):
            return addr
        time.sleep(1.0)
    return None


def front(d):
    top = run("-s", d, "shell", "dumpsys", "activity", "activities")
    m = re.search(r"topResumedActivity=\S+ \S+ (\S+)/", top)
    return m and m.group(1) == PKG


def open_app(d):
    if not front(d):
        run("-s", d, "shell", "monkey", "-p", PKG, "-c", "android.intent.category.LAUNCHER", "1")
        time.sleep(2.5)


def send(d, cmd, v=""):
    args = ["-s", d, "shell", "am", "broadcast", "-a", ACTION, "-p", PKG, "--es", "cmd", cmd]
    if v:
        args += ["--es", "v", shlex.quote(v)]     # the phone's shell splits on spaces: "fps 25" stays one value
    out = run(*args)
    m = re.search(r'data="(.*)"', out, re.S)
    if not m:
        sys.exit("mcam: the camera did not answer (is it v139 or later, and open?)\n" + out.strip())
    return m.group(1)


def parse(answer):
    said, _, rest = answer.partition("\n")
    return said, dict(l.split("=", 1) for l in rest.splitlines() if "=" in l)


def fix(d):
    """A first look: too dark → the light, then +EV; too bright → light off, then −EV; white balance measured."""
    said, s = parse(send(d, "state"))
    b = float(s.get("brightness", "nan")) if s.get("brightness", "-") != "-" else None
    done = []
    if b is not None and b < 0.30:
        if s.get("torch") == "false":
            done.append(parse(send(d, "torch", "on"))[0])
        elif s.get("exposure") == "auto":
            done.append(parse(send(d, "ev", "+1"))[0])
    elif b is not None and b > 0.75:
        if s.get("torch") == "true":
            done.append(parse(send(d, "torch", "off"))[0])
        elif s.get("exposure") == "auto":
            done.append(parse(send(d, "ev", "-1"))[0])
    done.append(parse(send(d, "wb", "auto"))[0])
    time.sleep(3)
    print(f"brightness was {b}; " + "; ".join(done))
    print(send(d, "state"))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip()); return
    d = device()
    cmd, v = argv[0], " ".join(argv[1:])
    if cmd == "snap":
        out = v or "mcam.png"
        with open(out, "wb") as f:
            f.write(subprocess.run([ADB, "-s", d, "exec-out", "screencap", "-p"], capture_output=True).stdout)
        print(out); return
    open_app(d)
    if cmd == "open":
        print("open"); return
    if cmd == "fix":
        fix(d); return
    print(send(d, cmd, v))


if __name__ == "__main__":
    main(sys.argv[1:])
