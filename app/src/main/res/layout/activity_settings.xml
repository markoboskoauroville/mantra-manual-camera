<?xml version="1.0" encoding="utf-8"?>
<!--
     SETTINGS, v111 (Marko, 2.10.2026): "This settings title is not needed ... in the area where there is this torch
     ... there will be toggles for adjusting camera settings. These are quick settings, and down there are better
     organized settings"; "I prefer to tab the interface rather than scrolling ... Above these tabs there is a quick
     settings toggles, and that's our new user interface for settings."

     QUICK: the light, frame rate, bit depth, resolution — one key each, a tap steps to the next value — and the three
     marks with their icons and a size in steps of 25 %. Then the TABS: CAMERA, OUTPUTS, DISPLAY, MORE. Only one tab's
     page shows; a long page still scrolls inside itself.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fitsSystemWindows="true">
<!-- v112: the margins live on this inner layer. On the root, fitsSystemWindows replaced the padding with the
     bars' insets, so in landscape OUTPUTS and FILE touched the screen and the switches were glued to the edge. -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/torch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="light"
            android:src="@drawable/ic_torch" />
        <Button
            android:id="@+id/fpsToggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="30 FPS"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/sand"
            android:fontFamily="monospace" />
        <Button
            android:id="@+id/depthToggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="10-BIT"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/sand"
            android:fontFamily="monospace" />
        <Button
            android:id="@+id/resToggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="4K"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/sand"
            android:fontFamily="monospace" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button
            android:id="@+id/minimal"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/minimal"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:fontFamily="monospace" />
        <TextView
            android:id="@+id/headerVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/amber" />
        <!-- v130: the way out (Marko, 3.10.2026: "for the settings, i need close button to exit settings") -->
        <TextView
            android:id="@+id/closeSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:contentDescription="close"
            android:fontFamily="monospace"
            android:text="✕"
            android:textSize="22sp"
            android:textColor="@color/sand" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp">
            <!-- v144: F and E pressed together to their own width, UPDATE at the end of the same row (Marko,
                 26.10.2026: "You need to compress this and add an update button in that same row") -->
            <com.mantraproductions.ndi.RailButton
                android:id="@+id/iconSquare"
                android:layout_width="36dp"
                android:layout_height="36dp" />
            <Spinner
                android:id="@+id/sizeSquare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <com.mantraproductions.ndi.RailButton
                android:id="@+id/iconCircle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp" />
            <Spinner
                android:id="@+id/sizeCircle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <Button
                android:id="@+id/updateApp"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="UPDATE"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/amber"
                android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">
            <TextView
                android:id="@+id/tabCamera"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="CAMERA" />
            <TextView
                android:id="@+id/tabFocus"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="FOCUS" />
            <TextView
                android:id="@+id/tabTrack"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="TRACK" />
            <TextView
                android:id="@+id/tabOutputs"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="OUTPUTS" />
            <TextView
                android:id="@+id/tabSound"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="SOUND" />
            <TextView
                android:id="@+id/tabDisplay"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="LOOK" />
            <TextView
                android:id="@+id/tabSony"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="SONY" />
            <TextView
                android:id="@+id/tabMore"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="MORE" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/slate" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">
            <LinearLayout
                android:id="@+id/pageCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">
        <!-- v145: the light's brightness (Marko, 26.10.2026: "in our settings we can have brightness control for the LED") -->
        <TextView style="@style/MantraLabel" android:text="LIGHT" />
        <TextView android:id="@+id/torchLevelValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/torchLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="99" />
        <!-- v97: the picture path, and the stream's own bit rate on the GPU stage -->
        <TextView style="@style/MantraLabel" android:text="@string/picture_path" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/picture_path_hint" />
        <RadioGroup
            android:id="@+id/picturePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
        <TextView android:tag="hint" style="@style/MantraHint"
            android:text="@string/depth_hint" />
            </LinearLayout>
            <!-- v147: FOCUS, its own tab (Marko, 26.10.2026: "there should be a special tab for focus, because focus is
                 now becoming very sophisticated with all its helpers") -->
            <LinearLayout
                android:id="@+id/pageFocus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
        <!-- v149: the focus puller's meter (Marko, 26.10.2026: "Focus pulling is the function of the second phone and on
             this phone as well. This is in Settings") -->
        <Switch
            android:id="@+id/focusPuller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/sand"
            android:text="FOCUS PULLER" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="A meter along the picture's long edge. The lens is the white triangle with its white circle: drag the circle up and down to pull focus by hand, hold it for ADD KEYFRAME or DELETE KEYFRAME. Tap a keyframe's amber circle to rack there at FOCUS SPEED (or over the ramp at CAMERA), hold it to delete it. ▶ goes to the next keyframe." />
        <!-- v147: the speeds in millimetres per second (Marko, 26.10.2026: "a speed of tracking and a speed of focusing ...
             let's put millimeters per second") -->
        <TextView style="@style/MantraLabel" android:text="SPEED" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="How fast the lens travels, as distance in front of the camera per second, eased in and out. FOCUS is a tap, a rack or a new mark; TRACKING is the lens following a tracked subject. Leftmost is CAMERA: the camera's own glide, which never jumps but cannot be timed. With a speed the camera first finds the mark, then the lens walks there." />
        <TextView android:id="@+id/focusSpeedValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/focusSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />
        <TextView android:id="@+id/trackSpeedValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/trackSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <!-- Focus -->
        <TextView style="@style/MantraLabel" android:text="@string/focus" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/focus_hint" />
        <TextView android:id="@+id/holdValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/hold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />
        <TextView android:id="@+id/rackValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/rack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <!-- Peaking -->
        <TextView style="@style/MantraLabel" android:text="@string/peaking" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/peaking_hint" />
        <TextView android:id="@+id/peakValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/peak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />
        <RadioGroup
            android:id="@+id/peakColour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp" />
            </LinearLayout>
            <!-- v147: TRACK, tracking focus on its own tab (Marko, 26.10.2026: "more logical tabs ... not so much scrolling down") -->
            <LinearLayout
                android:id="@+id/pageTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
        <!-- v99: tracking focus, every parameter -->
        <TextView style="@style/MantraLabel" android:text="@string/tracking" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/tracking_hint" />
        <TextView android:id="@+id/trackSearchValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/trackSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="25" />
        <TextView android:id="@+id/trackEveryValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/trackEvery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9" />
        <TextView android:id="@+id/trackConfidenceValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/trackConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="75" />
        <TextView android:id="@+id/trackToleranceValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/trackTolerance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="24" />
        <TextView android:id="@+id/trackFollowValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/trackFollow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="90" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pageOutputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
        <!-- v112: the two bit rates, named by what they are for (Marko: "Just say recording and streaming") -->
        <!--
             The wire first.

             This is the one he changes on nearly every shoot, and it was four
             blocks down the page under two things that get set once and left.
             What is touched most often goes at the top.
        -->
        <TextView style="@style/MantraLabel" android:text="@string/bitrate" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/bitrate_hint" />
        <TextView
            android:id="@+id/bitRateValue"
            style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/bitRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="99" />
        <TextView style="@style/MantraLabel" android:text="@string/stream_bitrate" />
        <TextView
            android:id="@+id/streamBitRateValue"
            style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/streamBitRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="48" />
        <TextView style="@style/MantraLabel" android:text="@string/outputs" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/outputs_hint" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/sand"
                android:text="FILE" />
            <Switch
                android:id="@+id/armFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/panelFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:visibility="gone">
            <TextView style="@style/MantraLabel" android:text="@string/record_to" />
            <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/record_to_hint" />
            <TextView android:id="@+id/recordFolder" style="@style/MantraValue" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/chooseFolder"
                    style="@style/MantraKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/choose_folder" />
                <Button
                    android:id="@+id/defaultFolder"
                    style="@style/MantraKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/default_folder" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/sand"
                android:text="USB" />
            <Switch
                android:id="@+id/armUsb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/panelUsb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:visibility="gone">
            <TextView style="@style/MantraHint" android:text="@string/usb_obs_soon" />
            <!-- The cable -->
            <TextView style="@style/MantraLabel" android:text="@string/usb" />
            <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/usb_hint" />
            <TextView
                android:id="@+id/usbState"
                style="@style/MantraValue"
                android:lineSpacingMultiplier="1.35"
                android:paddingBottom="8dp" />
            <Button
                android:id="@+id/usbSettings"
                style="@style/MantraKey"
                android:layout_width="match_parent"
                android:text="@string/usb_open" />
            <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/usb_webcam" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/sand"
                android:text="NDI" />
            <Switch
                android:id="@+id/armNdi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/panelNdi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:visibility="gone">
            <TextView style="@style/MantraLabel" android:text="@string/ndi_kind" />
            <RadioGroup
                android:id="@+id/ndiKind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
            <!-- v135: the wire NDI goes out on -->
            <TextView style="@style/MantraLabel" android:text="NETWORK" />
            <TextView android:tag="hint" style="@style/MantraHint"
                android:text="WI-FI: the network the phone joined. USB CABLE: plug the phone into the computer and turn USB tethering on; the stream then goes down the cable only. The stream follows the wire: it stops when the wire goes and starts again on its new address." />
            <RadioGroup
                android:id="@+id/ndiTransport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
            <TextView
                android:id="@+id/ndiWire"
                style="@style/MantraValue"
                android:paddingBottom="6dp" />
            <Switch
                android:id="@+id/ndiAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/sand"
                android:text="SOUND IN THE STREAM" />
            <!-- The source name -->
            <TextView style="@style/MantraLabel" android:text="@string/source_name" />
            <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/source_name_hint" />
            <EditText
                android:id="@+id/sourceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/sand"
                android:textColorHint="@color/quiet"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:autofillHints="name"
                android:background="@color/surface"
                android:padding="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/sand"
                android:text="YOUTUBE" />
            <Switch
                android:id="@+id/armYoutube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/panelYoutube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:visibility="gone">
            <TextView style="@style/MantraHint" android:text="@string/youtube_soon" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/slate" />


            </LinearLayout>
            <!-- v147: SOUND on its own tab -->
            <LinearLayout
                android:id="@+id/pageSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
        <!-- v135: SOUND, which microphone feeds the meter, the file and the stream -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp">
            <TextView style="@style/MantraLabel" android:text="SOUND SOURCE" />
            <TextView android:tag="hint" style="@style/MantraHint"
                android:text="Feeds the meter, the file and the NDI stream. AUTO takes a USB-C microphone, audio interface or wireless receiver when one is plugged in, else the phone microphone. Plugging in or pulling out is followed live." />
            <RadioGroup
                android:id="@+id/audioSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <Switch
                android:id="@+id/audioStereo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/sand"
                android:text="STEREO (when the device has two channels)" />
            <TextView
                android:id="@+id/audioNow"
                style="@style/MantraValue"
                android:paddingBottom="6dp" />
        </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pageDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
        <!-- v106: "give me toggle in the settings to hide the streaming status display" -->
        <Switch
            android:id="@+id/showOutputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/sand"
            android:text="SHOW ON THE CAMERA" />
        <!-- v85: the LUT library, this lens's turn, zebra -->


        <TextView style="@style/MantraLabel" android:text="@string/luts" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/luts_hint" />
        <LinearLayout
            android:id="@+id/lutList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Button
            android:id="@+id/addLut"
            style="@style/MantraKey"
            android:layout_width="match_parent"
            android:text="@string/add_lut" />
        <TextView style="@style/MantraLabel" android:text="@string/zebra" />
        <TextView android:id="@+id/zebraValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/zebra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50" />
            </LinearLayout>
            <!-- v187: SONY, the Mantra Sony Remote inside the camera (Marko, 31.10.2026) -->
            <LinearLayout
                android:id="@+id/pageSony"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
        <Switch
            android:id="@+id/sonyRemote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/sand"
            android:text="SONY REMOTE" />
        <TextView android:tag="hint" style="@style/MantraHint"
            android:text="On: the phone is the Bluetooth remote of every Sony nearby (each camera: MENU → Network → Bluetooth → Bluetooth Rmt Ctrl: On, then pair). The top line says SONY, whether they record and how many. Hold REC two seconds: START SONY starts every Sony and this camera together." />
        <TextView
            android:id="@+id/sonyNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/quiet" />
        <Button
            android:id="@+id/openSony"
            style="@style/MantraKey"
            android:layout_width="match_parent"
            android:text="OPEN SONY REMOTE" />
        <TextView android:tag="hint" style="@style/MantraHint"
            android:text="The whole Mantra Sony Remote: the TC generator, time code into a Sony over USB, reading a Sony's time code from its screen, REC ALL, SYNC CAMERA REC BUTTONS, the clap, LTC out. Every take of this camera carries a free-run time code from the same generator, so its files line up with the Sonys'." />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pageMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
        <!-- v144: the adb door (Marko, 26.10.2026: "add a switch ADB control, which is on by default") -->
        <Switch
            android:id="@+id/adbControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/sand"
            android:text="ADB CONTROL" />
        <TextView android:tag="hint" style="@style/MantraHint"
            android:text="On, a Mac on the cable or on wireless debugging drives every key and every setting of this camera through adb (scripts/mcam). Only adb's shell can, no app on the phone." />
        <!-- v150 (Marko, 26.10.2026: "in settings, there must be a guide on how to set up ADB wireless") -->
        <Button
            android:id="@+id/adbGuide"
            style="@style/MantraKey"
            android:layout_width="match_parent"
            android:text="WIRELESS DEBUGGING: THE GUIDE" />
        <!-- The trace -->
        <TextView style="@style/MantraLabel" android:text="@string/trace" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/trace_hint" />
        <Button
            android:id="@+id/exportTrace"
            style="@style/MantraKey"
            android:layout_width="match_parent"
            android:text="@string/export_trace" />

        <!-- What the licence requires, and where it belongs -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="14dp"
            android:background="@color/slate" />

        <TextView
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/quiet"
            android:text="@string/ndi_mark" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:textColor="@color/quiet" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
</FrameLayout>
