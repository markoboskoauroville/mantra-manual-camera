<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The take has sound, and the meter runs whether or not a take does: a
         microphone found dead after the shoot is a shoot that happens again. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- v187: SONY REMOTE inside the camera, the phone as the Sonys' Bluetooth remote commander (SONY_REMOTE_CONTROLLER) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- NDI: the source is advertised and the frames go out over the local
         network. INTERNET covers the sockets; the multicast permissions are
         what let a receiver on the same Wi-Fi discover the phone at all. A
         phone that streams perfectly and appears in nobody's source list is
         the failure these two prevent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v120: the low-latency Wi-Fi lock (no power save while NDI flows) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- v136: NDI goes on with the app in the background: a camera | microphone foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only needed below Android 10. From Q a DNG and a trace reach Downloads
         through MediaStore instead, which is the route that actually works and
         the reason the old reporter never wrote a file. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".MantraApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Mantra Manual Camera"
        android:theme="@style/Theme.MantraNdi"
        android:supportsRtl="true">

        <!-- v163: LANDSCAPE, ALWAYS. The screen never turns; when the phone does, only the rail keys' words and the
             focus ruler's distances turn to stay upright (MainActivity.holding; Marko, 28.10.2026). v162's upright
             layout collapsed into the top corner.

             The turn is handled here rather than by being recreated:
             recreating would tear down the capture session and the NDI source,
             which on a live stream is a dropped input at the far end. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:screenOrientation="fullUser" />

        <!-- v187: SONY REMOTE, the Mantra Sony Remote's TC JAM, opened from Settings → SONY and by a Sony on USB -->
        <activity
            android:name=".sony.TcJamActivity"
            android:label="Sony Remote"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" android:resource="@xml/sony_usb" />
        </activity>

        <service
            android:name=".StreamService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>
</manifest>
